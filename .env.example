# ─────────────────────────────────────────────────────────────────────────────
# OE AI — Variables de entorno (plantilla)
# Copia este archivo a .env (local) y añade los mismos valores en Vercel
# (Project Settings → Environment Variables). NUNCA subas el .env real a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL en Supabase) ───────────────────────────────────
# Usa el POOLER DE SESIÓN (IPv4) — funciona tanto en local como en Vercel.
# Supabase Dashboard → Connect → Connection string → "Session pooler" (puerto 5432).
# El host directo db.<ref>.supabase.co:5432 es IPv6-only y NO sirve para Vercel.
DATABASE_URL=postgresql://postgres.<TU_PROJECT_REF>:<TU_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# ── Supabase (OAuth Google/GitHub + PostgreSQL) ──────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<TU_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<TU_ANON_KEY>

# ── OpenRouter (rutas de catálogo LLM + respaldo de chat + imágenes) ─────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Lista de rutas habilitadas (IDs del catálogo separados por coma). Se copia
# del .env local del sandbox (OE_AI_MODEL_ROUTES).
OE_AI_MODEL_ROUTES=...

# ── Google Gemini (respaldo directo de chat/visión/imagen/búsqueda/ASR) ──────
# https://aistudio.google.com/apikey — el modelo se puede cambiar sin tocar código.
GEMINI_API_KEY=...
GEMINI_BUILD_MODEL=gemini-3.1-pro-preview
# Opcional: fija el modelo de imagen (por defecto cascade 2.5-flash-image → 3-pro-image-preview)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Groq (opcional; núcleo del Constructor de Apps) ──────────────────────────
# Si la región del servidor está bloqueada por Groq (403), la cascada continúa.
GROQ_API_KEY=gsk_...
GROQ_BUILD_MODEL=openai/gpt-oss-120b

# ── ElevenLabs (lectura en voz alta / TTS) ───────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_API_KEY_FALLBACK=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── JSON2Video (generación de video narrado) ─────────────────────────────────
JSON2VIDEO_API_KEY=...
JSON2VIDEO_TEMPLATE_ID=...
JSON2VIDEO_VOICE=en-US-NovaTurboMultilingualNeural

# ── Tokens propios de OE AI ──────────────────────────────────────────────────
# Clave de la API pública v1 y token del panel de administración.
OE_AI_API_KEY=...
OE_AI_ADMIN_TOKEN=...
